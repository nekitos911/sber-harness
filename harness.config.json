{
  "host": "127.0.0.1",
  "port": 4777,
  "dataDir": "./data",
  "shell": { "command": "powershell.exe", "args": ["-NoLogo"] },
  "defaultAgent": "gigacode",
  "workspaces": { "root": null, "repos": [] },
  "worktreeRoot": null,
  "git": {
    "defaultBase": "develop",
    "branchTemplate": "feature/{key}",
    "portBranchTemplate": "{branch}-{target}",
    "commitTitleTemplate": "{key}: {title}",
    "prTitleTemplate": "{key}: {title}"
  },
  "tasks": {
    "promptTemplate": "{key}: {title}\n\n{description}\n\nTarget branches: {targets}\nLink: {taskUrl}{notes}"
  },
  "session": { "idleWindowSec": 90 },
  "orchestration": { "workerMayCommit": false },
  "agents": {
    "gigacode": {
      "launcher": "gigacode",
      "label": "GigaCode",
      "command": "C:/Program Files/.gigacode/bin/gigacode.cmd",
      "node": null,
      "cliEntry": null,
      "nodeArgs": ["--max-old-space-size=6144"],
      "approvalMode": "auto",
      "approvalModes": ["plan", "default", "auto-edit", "auto"],
      "model": null,
      "settingsEnv": "GIGACODE_SYSTEM_SETTINGS_PATH",
      "settings": {
        "agents": { "modelGrades": {}, "allowedGrades": [] },
        "chatRecording": true
      },
      "taskPromptTemplate": null,
      "firstEventTimeoutMs": 30000,
      "env": {}
    },
    "claude": {
      "launcher": "claude",
      "label": "Claude Code",
      "command": "claude",
      "approvalMode": "acceptEdits",
      "approvalModes": ["default", "acceptEdits", "plan", "bypassPermissions"],
      "enabled": false
    },
    "mock": {
      "launcher": "mock",
      "label": "Mock agent (demo)",
      "approvalMode": "auto",
      "approvalModes": ["plan", "default", "auto-edit", "auto"]
    }
  },
  "agentMcpServers": {},
  "mcpServersFrom": "~/.gigacode/settings.json",
  "mcpServers": {
    "mock-tracker": {
      "enabled": false,
      "transport": "stdio",
      "command": "node",
      "args": ["scripts/mock-mcp.js"],
      "timeoutMs": 15000
    }
  },
  "mcpSecretsFile": null,
  "integrations": {
    "tasks": {
      "enabled": false,
      "server": "onework",
      "tools": {
        "find": "sbertrack_findIssues",
        "get": "sbertrack_getIssue",
        "meta": "sbertrack_getIssueMeta",
        "transition": "sbertrack_updateIssueStatus",
        "links": "sbertrack_listLinks",
        "me": "sbertrack_getUser"
      },
      "args": {},
      "limit": 30,
      "refreshSec": 0,
      "itemsPath": "issues",
      "map": {
        "externalId": "key",
        "title": "summary",
        "description": "description",
        "externalUrl": "url",
        "status": "status",
        "priority": "priority"
      },
      "statusMap": { "Open": "todo", "In Progress": "in_progress", "Review": "review", "Done": "done" },
      "closedStatuses": ["Closed", "Cancelled", "Declined"],
      "transition": { "args": { "key": "{key}", "status": "{status}", "comment": "{comment}" } }
    },
    "pr": {
      "enabled": false,
      "server": "sourcecontrol",
      "tool": "create_pull_request",
      "args": { "repo": "{repo}", "source": "{branch}", "target": "{base}", "title": "{title}", "description": "{body}" },
      "urlPath": "url"
    }
  }
}

{
  "host": "127.0.0.1",
  "port": 4777,
  "dataDir": "./data",
  "shell": null,
  "defaultAgent": "gigacode",
  "workspaces": { "root": null, "repos": [] },
  "worktreeRoot": null,
  "ide": null,
  "git": {
    "defaultBase": "develop",
    "branchTemplate": "feature/{key}",
    "portBranchTemplate": "{branch}-{targetSlug}",
    "commitTitleTemplate": "{key} {title}",
    "prTitleTemplate": "{key} {title}",
    "excludeFromCommit": [".superpowers/"]
  },
  "tasks": {
    "promptTemplate": "{key}: {title}\n\n{description}\n\nTarget branches: {targets}\nLink: {taskUrl}{notes}"
  },
  "session": { "idleWindowSec": 90 },
  "orchestration": {
    "workerMayCommit": false,
    "reviewMode": "builtin",
    "subagents": "harness",
    "review": {
      "grade": "review",
      "approvalMode": "plan",
      "maxRounds": 2,
      "agent": null,
      "promptTemplate": "Ты — ревьюер задачи {key} «{title}» (раунд {round}). Рабочая папка: {cwd}, ветка {branch}, база {base}.\nПроверь изменения задачи: `git diff {base}...HEAD` плюс незакоммиченные правки (`git status`, `git diff`). Ничего не меняй и не коммить — только читай и запускай проверки.\n\nОписание задачи:\n{description}\n{previous}\nПеречисли замечания по важности: CRITICAL / HIGH / MEDIUM / LOW — файл, строка, что не так и как исправить.\nВ конце вызови worker_done(status: \"done\"); summary должен заканчиваться строкой\nVERDICT: APPROVED (если нет CRITICAL и HIGH) или VERDICT: CHANGES_REQUESTED."
    }
  },
  "board": {
    "columns": [
      { "status": "todo", "label": "К работе", "trackerStatuses": ["todo"] },
      { "status": "in_progress", "label": "В работе", "trackerStatuses": ["development", "to_code_review", "code_review", "discover_issue"] },
      { "status": "review", "label": "Тестирование", "trackerStatuses": ["qa", "ready_for_ift", "ift", "ready_for_uat"] }
    ],
    "onWorkerDone": "stay",
    "moveSyncsTracker": false,
    "columnTransitions": {}
  },
  "agents": {
    "gigacode": {
      "launcher": "gigacode",
      "label": "GigaCode",
      "command": null,
      "node": null,
      "cliEntry": null,
      "nodeArgs": ["--max-old-space-size=6144"],
      "approvalMode": "auto",
      "approvalModes": ["plan", "default", "auto-edit", "auto"],
      "model": null,
      "models": [
        { "id": "Qwen3.8-Flash-Next-262k", "label": "Qwen 3.8 Flash Next", "context": "262k" },
        { "id": "DeepSeek-V4.1-Flash-1017-262k", "label": "DeepSeek V4.1 Flash", "context": "262k" },
        { "id": "GLM-5.3-Flash-262k", "label": "GLM 5.3 Flash", "context": "262k" },
        { "id": "Qwen3.6-35B-262k", "label": "Qwen 3.6 35B", "context": "262k" },
        { "id": "GigaChat-3.5-Ultra-Preview-128k", "label": "GigaChat 3.5 Ultra Preview", "context": "128k" }
      ],
      "approvalModeLabels": {
        "plan": "Только план — ничего не меняет",
        "default": "Спрашивать перед действиями",
        "auto-edit": "Правки файлов без подтверждения",
        "auto": "Авто (в headless = auto-edit; полный auto — с песочницей)"
      },
      "settingsEnv": "GIGACODE_SYSTEM_SETTINGS_PATH",
      "settings": {
        "agents": {
          "modelGrades": {},
          "allowedGrades": []
        },
        "chatRecording": true
      },
      "modelsDiscovery": { "prompt": "/models", "maxAgeHours": 24 },
      "modelRefsScan": ["~/.gigacode/agents/*.md", "~/.gigacode/commands/*.md"],
      "history": { "dirs": ["~/.gigacode/tmp/*/chats"], "command": null },
      "taskPromptPresets": ["/full-task {taskUrl}{notes}", "/full-task-ui {taskUrl}{notes}", "{key} {title}\n\n{description}"],
      "inheritUserMcp": false,
      "agentToolHook": null,
      "taskPromptTemplate": "/full-task {taskUrl}{notes}",
      "reworkPromptTemplate": "/full-task {taskUrl} Задача готова, но нужны правки: {notes}",
      "firstEventTimeoutMs": 120000,
      "authTimeoutMs": 600000,
      "env": {}
    },
    "claude": {
      "launcher": "claude",
      "label": "Claude Code",
      "command": "claude",
      "approvalMode": "acceptEdits",
      "approvalModes": ["default", "acceptEdits", "plan", "bypassPermissions"],
      "enabled": false
    },
    "mock": {
      "launcher": "mock",
      "label": "Mock agent (demo)",
      "approvalMode": "auto",
      "approvalModes": ["plan", "default", "auto-edit", "auto"],
      "modelsDiscovery": { "prompt": "/models", "maxAgeHours": 24 },
      "settings": {
        "agents": {
          "modelGrades": {
            "default": "Qwen3.8-Flash-Next-262k",
            "fast": "DeepSeek-V4.1-Flash-1017-262k",
            "review": "GLM-5.3-Flash-262k",
            "explore": "Qwen3.6-35B-262k"
          },
          "allowedGrades": ["default", "fast", "review", "explore"]
        },
        "chatRecording": true
      }
    }
  },
  "agentMcpServers": {},
  "mcpServersFrom": "~/.gigacode/settings.json",
  "mcpServers": {
    "mock-tracker": {
      "enabled": false,
      "transport": "stdio",
      "command": "node",
      "args": ["scripts/mock-mcp.js"],
      "timeoutMs": 15000
    }
  },
  "mcpSecretsFile": null,
  "integrations": {
    "tasks": {
      "enabled": false,
      "format": "onework-markdown",
      "server": "onework",
      "space": "PROJ",
      "tools": {
        "find": "sbertrack_findIssues",
        "get": "sbertrack_getIssue",
        "meta": "sbertrack_getIssueMeta",
        "transition": "sbertrack_updateIssueStatus",
        "links": "sbertrack_listLinks",
        "me": "sbertrack_getUser"
      },
      "args": {},
      "limit": 100,
      "refreshSec": 0,
      "urlTemplate": "",
      "statusMap": {
        "todo": "todo",
        "development": "in_progress",
        "to_code_review": "review",
        "code_review": "review",
        "qa": "review",
        "ready_for_ift": "review",
        "ift": "review",
        "ready_for_uat": "review",
        "done": "done"
      },
      "priorityMap": { "low": "low", "mid": "medium", "medium": "medium", "high": "high" },
      "closedStatuses": ["done", "cancelled", "declined"],
      "onStartTransition": null
    },
    "pr": {
      "enabled": false,
      "server": "sourcecontrol",
      "tool": "git_create_pull_request",
      "args": {
        "project": "{project}",
        "repository": "{repository}",
        "head": "{branch}",
        "base": "{base}",
        "title": "{title}",
        "body": "{body}"
      },
      "urlPath": "html_url",
      "listTool": "git_list_pull_requests",
      "listArgs": { "project": "{project}", "repository": "{repository}", "state": "OPEN", "page": 1, "limit": 100 },
      "listItemsPath": "pulls",
      "limits": { "titleBytes": 100, "bodyBytes": 512 }
    }
  }
}

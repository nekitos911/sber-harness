{
  "name": "sber-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Local UI harness for coding agents (GigaCode and others): chats, orchestration, task board, terminals, git.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "harness": "mcp/harness-mcp.js"
  },
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "node scripts/ensure-bin.js && vite build",
    "start": "node server/index.js",
    "desktop": "node scripts/ensure-bin.js && node scripts/desktop.js --ui",
    "shortcut": "node scripts/shortcut.js",
    "check": "node server/index.js --check",
    "test": "node --test \"test/*.test.js\"",
    "typecheck": "node scripts/ensure-bin.js && tsc -p web --noEmit",
    "demo": "node server/index.js --demo",
    "start:bg": "node scripts/background.js start",
    "stop": "node scripts/background.js stop"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "undici": "^7.16.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "electron": "^45.4.1",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
